# Social Cleaner — environment template.
# Copy to .env.local or run `npm run setup` (generates a random key set).

# 32 random bytes, base64. Protects all encrypted vault fields and blind indexes.
# Rotating this key without a re-encryption migration makes existing data unreadable.
SC_MASTER_KEY=

# Base URL used in generated reports and cookies. No trailing slash.
SC_APP_URL=http://localhost:3000

# Optional: absolute path for the SQLite database file (default: <repo>/data/app.db)
# SC_DATABASE_URL=file:./data/app.db

# Search provider for name/e-mail/phone lookups: brave | tavily | free.
# free = GitHub + Gravatar only (limited coverage); brave/tavily need a key.
# Leave as mock (or empty) to disable; the API then returns 503 instead of fake results.
SC_SEARCH_PROVIDER=mock
SC_SEARCH_API_KEY=

# Phase 3+ — AI provider (not wired yet).
SC_AI_PROVIDER=mock
SC_AI_API_KEY=

# Phase 5+ — breach notification provider.
SC_BREACH_PROVIDER=disabled
SC_BREACH_API_KEY=
